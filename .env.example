# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (Nuxt dev server etc.)
CORS_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vang_clan?schema=public

# ── Auth (JWT) ──────────────────────────────────────────
# Use long random strings. Generate e.g. with: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# ── File upload (member photos & payment slips) ─────────
# Cloudinary. Leave CLOUDINARY_CLOUD_NAME blank to fall back to local disk
# under ./uploads. Every asset this app writes is confined to
# CLOUDINARY_FOLDER, so the account can be shared with other projects.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hmong_clan_image
UPLOAD_DIR=uploads

# ── Money / locale ──────────────────────────────────────
# Default currency for dues/donations/aid (overseas members may differ).
DEFAULT_CURRENCY=LAK
